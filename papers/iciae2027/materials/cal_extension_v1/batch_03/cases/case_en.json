      "fixed_claims": [
        {
          "claim_id": "c1",
          "text": "Bill Irwin plays Mr. Noodle's brother Mister Noodle on Sesame Street."
        }
      ],
      "verdicts": [
        {
          "claim_id": "c1",
          "label": "contradicted",
          "reason": "Sources state Irwin played Mr. Noodle, not brother Mister Noodle; Jeter replaced Irwin as Mister Noodle.",
          "evidence": [
            {
              "passage_id": "864105695_186-627",
              "quote": "Mr. Noodle and his siblings -- Mr. Noodle 's brother Mister Noodle , Ms Noodle , and Miss Noodle -- are characters who appear in the `` Elmo 's World '' segments during the educational children 's television program Sesame Street . Mr. Noodle was played by Broadway actor Bill Irwin , who had previously worked with Arlene Sherman , executive producer of Sesame Street and co-creator of `` Elmo 's World '' , in short films for the program ."
            },
            {
              "passage_id": "864105695_628-1228",
              "quote": "When Irwin became unavailable , Sherman asked Michael Jeter , who was her friend , to replace Irwin as Mr. Noodle 's brother Mister Noodle , which he accepted enthusiastically , calling it his favorite role in twenty years . Jeter was in the role beginning in 2000 , until his death in 2003 . Kristin Chenoweth played Mr. Noodle 's sister Ms. Noodle , and Sarah Jones played Mr. Noodle 's other sister Miss Noodle . As of January 2017 , Daveed Diggs and comedian Daniel Koren , have played two more of Mr. Noodle 's brothers . Five actors playing members of the Noodle family have won Tonys . Michael"
            }
          ]
        }
      ],
