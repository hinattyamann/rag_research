{
  "auxiliary_runtime": {
    "context_tokens": 12288,
    "temperature": 0.2,
    "seed": 42,
    "threads": 6,
    "batch_tokens": 128,
    "repack": false,
    "timeout_seconds": 1200,
    "startup_timeout_seconds": 120
  },
  "sampling": {
    "version": "auxiliary-sampling-v1",
    "top_k": 20,
    "top_p": 0.95,
    "min_p": 0.0,
    "presence_penalty": 1.5,
    "repeat_last_n": 64,
    "reasoning_budget_tokens": 4096,
    "final_json_grammar": true,
    "final_json_grammar_mode": "closing_tag_root_v3",
    "reasoning_prefill_mode": "chatml_think_suffix_v1"
  },
  "tasks": {
    "extract_claims": {
      "max_output_tokens": 3072
    },
    "verify_claims": {
      "max_output_tokens": 6144
    },
    "rewrite_answer": {
      "max_output_tokens": 6144
    }
  },
  "trials": {
    "order_conditions": [
      "original",
      "reversed",
      "shuffle_1",
      "shuffle_2",
      "shuffle_3"
    ],
    "shuffle_seed": 42,
    "same_order_total_trials": 5,
    "share_original_first_trial": true,
    "execution_order_seed": 43,
    "generation_seed_policy": "same_fixed_seed_for_every_trial",
    "deduplicate_order_permutations": true,
    "repeated_prompt_result_cache": false,
    "regenerate_claims_per_trial": false,
    "regenerate_answer_per_trial": false,
    "repack_or_truncate_per_trial": false
  },
  "errors": {
    "automatic_retries": 0,
    "input_overflow_action": "record_error_without_truncating",
    "preserve_failed_attempts": true,
    "resume_only_missing_trials": true,
    "reject_protocol_hash_mismatch": true
  },
  "execution": {
    "gpu_layers": 99,
    "device": "CUDA0",
    "require_full_offload": true
  }
}
